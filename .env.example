# ============================================================
# JETWASH24 — Environment Variables
# Copy this file to .env.local and fill in all values
# ============================================================

# ------ DATABASE ------
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/jetwash24?sslmode=require"

# ------ NEXTAUTH ------
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ------ STRIPE ------
# Reservation deposit (5€) is taken only when STRIPE_SECRET_KEY is set.
# Without these keys, bookings still work but skip the deposit.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From the Stripe webhook endpoint pointing at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------ CRON ------
# Bearer token protecting /api/cron/expire-bookings
CRON_SECRET="generate-with: openssl rand -base64 32"

# ------ RESEND (Email) ------
RESEND_API_KEY="re_..."
# The "from" address must be verified in your Resend account
RESEND_FROM_EMAIL="JetWash24 <noreply@jetwash24.com>"

# ------ ADMIN ------
ADMIN_EMAIL="jetwash24detailing@gmail.com"
WHATSAPP_NOTIFY_NUMBER="+351928380478"

# ------ VERCEL BLOB (Gallery images) ------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ------ APP ------
NEXT_PUBLIC_URL="http://localhost:3000"
# In production: NEXT_PUBLIC_URL="https://jetwash24.com"

# ------ WEBHOOK (WhatsApp automation) ------
# URL of your WhatsApp automation webhook (e.g. Make.com, n8n, Zapier)
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_SECRET=""
