generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Addon {
  id            String         @id @default(cuid())
  name          String
  namePt        String
  nameEn        String
  price         Float
  duration      Int
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookingAddons BookingAddon[]

  @@map("addons")
}

model BlockedSlot {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
  @@map("blocked_slots")
}

model BookingAddon {
  id        String  @id @default(cuid())
  bookingId String
  addonId   String
  addon     Addon   @relation(fields: [addonId], references: [id])
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_addons")
}

model Booking {
  id                String         @id @default(cuid())
  customerId        String
  serviceId         String
  vehicleSize       VehicleSize
  date              DateTime
  startTime         String
  endTime           String
  totalDuration     Int
  totalPrice        Float
  vehicleAdjustment Float          @default(0)
  depositAmount     Float          @default(0)
  remainingAmount   Float          @default(0)
  status            BookingStatus  @default(PENDING)
  stripeSessionId   String?        @unique
  stripePaymentId   String?
  cancelledAt       DateTime?
  cancellationNote  String?
  paymentExpiresAt  DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  addons            BookingAddon[]
  customer          Customer       @relation(fields: [customerId], references: [id])
  service           Service        @relation(fields: [serviceId], references: [id])

  @@index([date, status])
  @@map("bookings")
}

model Customer {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String
  carModel     String
  licensePlate String
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]

  @@map("customers")
}

model GalleryImage {
  id               String   @id @default(cuid())
  beforeImageUrl   String
  afterImageUrl    String
  description      String?
  descriptionPt    String?
  descriptionEn    String?
  servicePerformed String?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("gallery_images")
}

model Service {
  id             String          @id @default(cuid())
  name           String
  namePt         String
  nameEn         String
  description    String?
  descriptionPt  String?
  descriptionEn  String?
  includes       String[]
  includesPt     String[]
  includesEn     String[]
  price          Float
  compareAtPrice Float?
  duration       Int
  category       ServiceCategory
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       Booking[]

  @@map("services")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(WORKER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum Role {
  ADMIN
  WORKER
}

enum ServiceCategory {
  INTERIOR
  EXTERIOR
  POLISHING
  FULL
}

enum VehicleSize {
  SMALL
  MEDIUM
  SUV
  LARGE
  SUPERCAR
}

// ─── Shop ─────────────────────────────────────────────────────────────────────

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  namePt         String
  nameEn         String
  descriptionPt  String?
  descriptionEn  String?
  brand          String?
  sku            String?
  price          Float
  compareAtPrice Float?
  // Sourcing data, admin-only: never selected by the public catalogue queries.
  supplierUrl    String?
  supplierCost   Float?
  // Per-product delivery window in working days. Null falls back to the shop
  // default — set these when a product ships from an EU warehouse and arrives
  // far sooner than the catalogue's worst case.
  deliveryMinDays Int?
  deliveryMaxDays Int?
  images         String[]
  category       ProductCategory
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orderItems     OrderItem[]

  @@index([category, isActive])
  @@map("products")
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  name             String
  email            String
  phone            String
  nif              String?
  addressLine1     String
  addressLine2     String?
  postalCode       String
  city             String
  country          String      @default("PT")
  shippingZone     String
  notes            String?
  locale           String      @default("pt")
  subtotal         Float
  shippingCost     Float
  total            Float
  status           OrderStatus @default(PENDING)
  stripeSessionId  String?     @unique
  stripePaymentId  String?
  trackingCode     String?
  paymentExpiresAt DateTime?
  paidAt           DateTime?
  shippedAt        DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]

  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  namePt    String
  nameEn    String
  unitPrice Float
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum ProductCategory {
  WASH
  INTERIOR
  POLISH
  PROTECTION
  WHEELS
  ACCESSORIES
  KITS
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED
}
