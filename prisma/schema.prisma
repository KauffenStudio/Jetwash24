generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Addon {
  id             String         @id @default(cuid())
  name           String
  namePt         String
  nameEn         String
  price          Float
  duration       Int
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bookingAddons  BookingAddon[]

  @@map("addons")
}

model BlockedSlot {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
  @@map("blocked_slots")
}

model BookingAddon {
  id        String  @id @default(cuid())
  bookingId String
  addonId   String
  addon     Addon   @relation(fields: [addonId], references: [id])
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_addons")
}

model Booking {
  id                String         @id @default(cuid())
  customerId        String
  serviceId         String
  vehicleSize       VehicleSize
  date              DateTime
  startTime         String
  endTime           String
  totalDuration     Int
  totalPrice        Float
  vehicleAdjustment Float          @default(0)
  depositAmount     Float          @default(0)
  remainingAmount   Float          @default(0)
  status            BookingStatus  @default(PENDING)
  stripeSessionId   String?        @unique
  stripePaymentId   String?
  cancelledAt       DateTime?
  cancellationNote  String?
  paymentExpiresAt  DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  addons            BookingAddon[]
  customer          Customer       @relation(fields: [customerId], references: [id])
  service           Service        @relation(fields: [serviceId], references: [id])

  @@index([date, status])
  @@map("bookings")
}

model Customer {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String
  carModel     String
  licensePlate String
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]

  @@map("customers")
}

model GalleryImage {
  id               String   @id @default(cuid())
  beforeImageUrl   String
  afterImageUrl    String
  description      String?
  descriptionPt    String?
  descriptionEn    String?
  servicePerformed String?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("gallery_images")
}

model Service {
  id            String          @id @default(cuid())
  name          String
  namePt        String
  nameEn        String
  description   String?
  descriptionPt String?
  descriptionEn String?
  includes      String[]
  includesPt    String[]
  includesEn    String[]
  price          Float
  compareAtPrice Float?
  duration      Int
  category      ServiceCategory
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bookings      Booking[]

  @@map("services")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(WORKER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum Role {
  ADMIN
  WORKER
}

enum ServiceCategory {
  INTERIOR
  EXTERIOR
  FULL
}

enum VehicleSize {
  SMALL
  MEDIUM
  SUV
  LARGE
  SUPERCAR
}
